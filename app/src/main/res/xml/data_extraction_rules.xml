<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12+ (API 31+). See backup_rules.xml for the
    equivalent on older releases and for what is actually stored.

    Both paths carry the same single preferences file. The two are declared separately rather than
    with one shared rule because they are different decisions that happen to agree today:
    cloud-backup leaves the device and lands on Google's servers, device-transfer goes phone to
    phone. If anything sensitive is ever added to localuno_prefs, cloud-backup is the one to
    reconsider first.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="localuno_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="localuno_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
