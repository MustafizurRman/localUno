<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for local multiplayer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        No Bluetooth permissions. Five of them were declared for a "fallback transport" that was
        never built - nothing in the codebase has ever touched Bluetooth, and the transport is mDNS
        plus TCP over Wi-Fi. BLUETOOTH_SCAN in particular is a runtime permission that reads as
        location-adjacent, so a card game was asking for something alarming and unused. Removed.

        Kept deliberately: NEARBY_WIFI_DEVICES. It is not requested at runtime and so is never
        actually granted, which means nothing today can depend on it - but NsdManager's behaviour
        around it varies by OEM build, and discovery is the feature the whole app rests on. Left in
        place rather than removed on the same afternoon as everything else; if it goes, discovery
        needs testing across two real devices first.
    -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <!-- Turn alert. Compose's own HapticFeedback only exposes LongPress/TextHandleMove, which is
         already what a card tap uses - an alert that feels identical to the tap you just made is
         not an alert, so the turn cue drives the Vibrator directly with its own pattern. Normal
         permission, granted at install; no runtime request needed. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- QR join. The camera is a convenience path only: discovery, and manual IP entry, both work
         without it, so the feature is declared not-required and the app stays installable on a
         device with no camera at all. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalUno"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Overrides the zxing library's own landscape-friendly CaptureActivity declaration - see
            PortraitCaptureActivity. noHistory so a scanner left open is never what the task resumes
            to: the app can otherwise be killed while scanning and come back to a camera with the
            game nowhere in sight, which is a dead end with no obvious way out.
        -->
        <activity
            android:name=".ui.components.PortraitCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:noHistory="true"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
    </application>

</manifest>